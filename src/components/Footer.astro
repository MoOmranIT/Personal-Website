---
import { siteConfig } from '../scripts/siteConfig';

interface Props {
  translations?: {
    footer?: {
      brand?: {
        title?: string;
        subtitle?: string;
      };
      nav?: {
        home?: string;
        expertise?: string;
        ventures?: string;
        about?: string;
        proofInsights?: string;
        contact?: string;
      };
      getInTouch?: {
        heading?: string;
        email?: string;
        phone?: string;
        office?: string;
        getDirections?: string;
      };
      copyright?: string;
    };
  };
  lang?: string;
  isBlog?: boolean;
}

const { translations = {}, lang = 'en', isBlog = false } = Astro.props;
const t = translations.footer || {};
const year = new Date().getFullYear();
const sectionHref = (section: string) => isBlog ? (lang === 'ar' ? `/ar/#${section}` : `/#${section}`) : (lang === 'ar' ? `/ar/#${section}` : `#${section}`);
const blogHref = lang === 'ar' ? '/ar/blog/' : '/blog/';
---

<footer class="navy-grad text-white relative overflow-hidden">
  <div aria-hidden="true" class="absolute -top-24 right-0 w-64 h-64 sm:w-96 sm:h-96 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
  <div aria-hidden="true" class="absolute -bottom-8 left-0 w-56 h-40 sm:w-[24rem] sm:h-64 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-20">
    <div class="grid md:grid-cols-3 gap-12 md:gap-8">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="w-10 h-10 rounded-full bg-white/10 ring-1 ring-gold/40 flex items-center justify-center text-white font-bold text-lg">KM</span>
          <span class="leading-tight">
            <span class="block font-serif text-lg font-bold text-white">{t.brand?.title || siteConfig.name}</span>
            <span class="block text-[11px] uppercase tracking-[.2em] text-white/50">{t.brand?.subtitle || (lang === 'ar' ? 'مستشار أعمال واستشاري تسويق' : 'Strategic Business Development & Marketing Consultant')}</span>
          </span>
        </div>
        <p class="text-white/60 text-sm leading-relaxed max-w-xs">
          {lang === 'ar'
            ? 'استشارات استراتيجية وتسويقية وحلول نمو مبنية على أكثر من 18 عاماً من الخبرة في دبي والخليج.'
            : 'Strategic consulting, marketing and growth solutions built on 18+ years of experience across the Gulf.'}
        </p>
      </div>

      <nav class="space-y-3" aria-label={lang === 'ar' ? 'الروابط السريعة' : 'Quick Links'}>
        <h3 class="text-white/70 text-xs uppercase tracking-widest font-semibold mb-5">{lang === 'ar' ? 'روابط سريعة' : 'Quick Links'}</h3>
        <a href={sectionHref('home')} class="block text-white/80 text-sm hover:text-gold transition-colors">{t.nav?.home || (lang === 'ar' ? 'الرئيسية' : 'Home')}</a>
        <a href={sectionHref('services')} class="block text-white/80 text-sm hover:text-gold transition-colors">{t.nav?.expertise || (lang === 'ar' ? 'الخبرات' : 'Expertise')}</a>
        <a href={sectionHref('ventures')} class="block text-white/80 text-sm hover:text-gold transition-colors">{t.nav?.ventures || (lang === 'ar' ? 'المشاريع' : 'Ventures')}</a>
        <a href={sectionHref('about')} class="block text-white/80 text-sm hover:text-gold transition-colors">{t.nav?.about || (lang === 'ar' ? 'من أنا' : 'About Me')}</a>
        <a href={sectionHref('success')} class="block text-white/80 text-sm hover:text-gold transition-colors">{t.nav?.proofInsights || (lang === 'ar' ? 'قصص النجاح' : 'Proof & Insights')}</a>
        <a href={blogHref} class="block text-white/80 text-sm hover:text-gold transition-colors">{lang === 'ar' ? 'المدونة' : 'Blog'}</a>
        <a href={sectionHref('contact')} class="block text-white/80 text-sm hover:text-gold transition-colors">{t.nav?.contact || (lang === 'ar' ? 'تواصل' : 'Contact')}</a>
      </nav>

      <div class="space-y-3">
        <h3 class="text-white/70 text-xs uppercase tracking-widest font-semibold mb-5">{t.getInTouch?.heading || (lang === 'ar' ? 'تواصل معنا' : 'Get in Touch')}</h3>
        <a href={"mailto:" + siteConfig.contact.email} class="flex items-start gap-3 text-white/80 text-sm hover:text-gold transition-colors group">
          <span aria-hidden="true" class="text-base leading-none mt-0.5">✉️</span>
          <span class="group-hover:underline underline-offset-2 decoration-white/20 group-hover:decoration-gold/60">{siteConfig.contact.email}</span>
        </a>
        <a href={"tel:" + siteConfig.contact.phone.replace(/\s/g, '')} class="flex items-start gap-3 text-white/80 text-sm hover:text-gold transition-colors group">
          <span aria-hidden="true" class="text-base leading-none mt-0.5">📞</span>
          <span class="group-hover:underline underline-offset-2 decoration-white/20 group-hover:decoration-gold/60">+971 55 343 3150</span>
        </a>
        <a
          href="https://maps.app.goo.gl/gueak6ZVLNiN3eAF6"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={lang === 'ar' ? 'فتح موقع المكتب في Google Maps' : 'Open Dubai office location in Google Maps'}
          class="flex items-start gap-3 text-white/80 text-sm hover:text-gold transition-colors group"
        >
          <span aria-hidden="true" class="text-base leading-none mt-0.5">📍</span>
          <span class="group-hover:underline underline-offset-2 decoration-white/20 group-hover:decoration-gold/60">
            {t.getInTouch?.office || siteConfig.contact.address}
          </span>
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 mt-14 pt-6 text-center">
      <p class="text-white/50 text-sm">
        © <span id="year">{year}</span> {siteConfig.name}. {lang === 'ar' ? 'جميع الحقوق محفوظة.' : 'All rights reserved.'}
      </p>
    </div>
  </div>
</footer>
