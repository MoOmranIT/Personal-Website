---
interface Props {
  translations?: {
    about?: {
      badge?: string;
      heading?: string;
      subheading?: string;
      paragraphs?: string[];
      roles?: string[];
      closing?: string;
      books?: string[];
      cta?: string;
    };
  };
  lang?: string;
}

const { translations = {}, lang = 'en' } = Astro.props;
const t = translations.about || {};
---

<section id="about" class="py-24 bg-white relative overflow-hidden">
  <div class="hidden lg:block absolute top-0 right-0 w-96 h-96 bg-navy/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-5xl mx-auto px-5 sm:px-8 relative">
    <div class="text-center mb-14 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-slate-400 mb-3 block">
        {t.badge || 'Get To Know Me'}
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-navy title-underline inline-block">
        {t.heading || 'Who am I?'}
      </h2>
    </div>
    <div class="reveal-scale bg-slate-50 rounded-3xl p-8 sm:p-14 ring-1 ring-slate-100 shadow-sm relative overflow-hidden">
      <span aria-hidden="true" class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold/70 via-gold/90 to-gold/70 pointer-events-none"></span>
      <div class="space-y-6 text-slate-600 text-lg leading-relaxed">
        {(t.paragraphs || [
          'My work sits at the intersection of strategy, growth, and marketing. I hold a PhD in Marketing and have specialized in consumer behavior since 2016, a foundation that shapes every strategy I build today: not general opinions about what should work, but a grounded understanding of why people and markets actually behave the way they do.',
          'Alongside these roles, I work as a business growth consultant for UAE organizations that need a structured system, not just an outside opinion.',
          'That thinking is captured in three books, each drawn from real client work rather than theory:'
        ]).map((p, i) => (
          <p set:html={p} />
        ))}
      </div>
      <div class="mt-10">
        <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-6">What I Do Today?</h3>
        <ul class="grid gap-4 sm:grid-cols-2">
          {(t.roles || [
            'Chief Executive Officer: Elite Maison Marketing Consultancies',
            'Founder: AI Brains ecosystem (Kaveo, AIRIS, HOLORISER, MotorK)',
            'University Lecturer: Abu Dhabi University, Dubai Campus',
            'Executive Trainer: Strategy & business development programs',
            'Advisory appointments across UAE organizations'
          ]).map((role) => (
            <li class="flex items-start gap-3 rounded-2xl bg-white p-4 ring-1 ring-slate-100">
              <span aria-hidden="true" class="mt-0.5 h-2 w-2 rounded-full bg-gold"></span>
              <span class="text-slate-700">{role}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        {(t.books || [
          'The Business Developer\'s Mindset',
          'The Customer Effect',
          'Why People Buy'
        ]).map((book) => (
          <span class="rounded-full border border-navy/10 bg-white px-4 py-1.5 text-sm font-medium text-navy">{book}</span>
        ))}
      </div>
      <div class="mt-10 flex justify-center">
        <a href={lang === 'ar' ? '/ar/#contact' : '#contact'} class="btn-navy btn-sheen px-9 py-4 rounded-full font-semibold text-base">
          {t.cta || 'Work With Me'}
        </a>
      </div>
    </div>
  </div>
</section>
