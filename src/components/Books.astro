---
import { books } from '../data/books';

interface Props {
  translations?: {
    books?: {
      badge?: string;
      heading?: string;
      description?: string;
      cta?: string;
      close?: string;
    };
  };
  lang?: string;
}

const { translations = {}, lang = 'en' } = Astro.props;
const t = translations.books || {};
const isAr = lang === 'ar';
const localeBooks = books.map(b => ({
  id: b.id,
  title: isAr ? b.ar.title : b.en.title,
  image: isAr ? b.ar.image : b.en.image,
  alt: isAr ? b.ar.alt : b.en.alt,
  amazonUrl: isAr ? b.ar.amazonUrl : b.en.amazonUrl,
}));
const ctaText = t.cta || (isAr ? 'اشترِ من Amazon ↗' : 'Buy on Amazon ↗');
---

<section id="books" class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-10 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-slate-400 mb-3 block">
        {t.badge || 'Published Work'}
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-navy title-underline inline-block">
        {t.heading || 'My Books'}
      </h2>
      <p class="text-slate-500 max-w-2xl mx-auto mt-6">
        {t.description || 'Three essential reads on business development, customer experience, and consumer psychology — available in English and Arabic.'}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {localeBooks.map((book) => (
        <a
          href={book.amazonUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${book.title} — ${ctaText}`}
          class="group bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden hover:shadow-md hover:-translate-y-1 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 flex flex-col"
        >
          <div class="bg-slate-50 p-5 sm:p-6 flex items-center justify-center aspect-[3/4] overflow-hidden">
            <img
              src={book.image}
              alt={book.alt}
              width="400"
              height="533"
              class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="font-serif font-bold text-navy text-lg leading-snug mb-4 flex-grow">
              {book.title}
            </h3>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy/70 group-hover:text-navy transition-colors">
              <span>{ctaText}</span>
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">↗</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .group {
      transition: none !important;
    }
    .group img {
      transition: none !important;
    }
  }
</style>
