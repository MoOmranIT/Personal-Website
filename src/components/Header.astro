---
import { siteConfig } from '../scripts/siteConfig';

interface Props {
  translations?: {
    home?: string;
    about?: string;
    books?: string;
    contact?: string;
    menuOpen?: string;
    menuClose?: string;
    otherLang?: string;
    expertise?: string;
    proofInsights?: string;
    credentials?: string;
  };
  currentLang?: string;
}

const {
  translations = {},
  currentLang = 'en'
} = Astro.props;
const lang = currentLang;
const isAr = lang === 'ar';

const otherLang = isAr ? '/' : '/ar/';
const otherLangLabel = isAr ? 'English' : 'العربية';

const enSimpleLinks = [
  { href: '#home', label: translations.home || 'Home', id: 'home' },
  { href: '#ventures', label: 'Ventures', id: 'ventures' },
  { href: '#about', label: translations.about || 'About Me', id: 'about' },
];

const enExpertiseItems = [
  { href: '#executive-roles', label: 'Current Executive & Advisory Roles', id: 'executive-roles' },
  { href: '#services', label: 'Services', id: 'services' },
];

const enProofItems = [
  { href: '#stanford', label: translations.credentials || 'Stanford / Credentials', id: 'stanford' },
  { href: '#books', label: translations.books || 'My Books', id: 'books' },
  { href: '#success', label: 'Success Stories', id: 'success' },
];

const arLinks = [
  { href: '/ar/#home', label: translations.home || 'Home', id: 'home' },
  { href: '/ar/#ventures', label: 'Ventures', id: 'ventures' },
  { href: '/ar/#services', label: 'خدماتنا', id: 'services' },
  { href: '/ar/#about', label: translations.about || 'About Me', id: 'about' },
  { href: '/ar/#books', label: translations.books || 'My Books', id: 'books' },
  { href: '/ar/#success', label: 'قصص النجاح', id: 'success' },
];

const contactHref = isAr ? '/ar/#contact' : '#contact';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md transition-all duration-300">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 flex items-center justify-between h-20">
    <a href={isAr ? '/ar/' : '/'} class="flex items-center gap-3 group">
      <span class="w-11 h-11 rounded-full navy-grad flex items-center justify-center text-white font-bold text-lg transition-transform duration-500 group-hover:rotate-6 group-hover:scale-105">
        KM
      </span>
      <span class="leading-tight">
        <span class="block font-serif text-lg font-bold text-navy tracking-wide">
          {siteConfig.name}
        </span>
        <span class="block text-[11px] uppercase tracking-[.2em] text-slate-400">
          {isAr ? ' مستشار أعمال استراتيجي، تطوير وتسويق أعمال' : 'Strategic Business Development & Marketing Consultant'}
        </span>
      </span>
    </a>

    {isAr ? (
      <nav class="hidden xl:flex items-center gap-8 font-medium text-sm text-slate-700" aria-label="Primary">
        {arLinks.map((link) => (
          <a href={link.href} data-active="false" class="nav-link hover:text-navy transition-colors">{link.label}</a>
        ))}
      </nav>
    ) : (
      <nav class="hidden xl:flex items-center gap-6 xl:gap-8 font-medium text-sm text-slate-700" aria-label="Primary">
        {enSimpleLinks.map((link) => (
          <a href={link.href} data-active="false" class="nav-link hover:text-navy transition-colors">{link.label}</a>
        ))}
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="nav-link hover:text-navy transition-colors flex items-center gap-1"
            aria-expanded="false"
            aria-controls="dropdown-expertise"
            data-dropdown="dropdown-expertise"
          >
            {translations.expertise || 'Expertise'}
            <svg class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="dropdown-expertise"
            class="dropdown-panel absolute top-full left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 -translate-y-1 pointer-events-none transition-all duration-200 ease-out z-50"
          >
            <a href={enExpertiseItems[0].href} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{enExpertiseItems[0].label}</a>
            <a href={enExpertiseItems[1].href} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{enExpertiseItems[1].label}</a>
          </div>
        </div>
        <a href="#ventures" data-active="false" class="nav-link hover:text-navy transition-colors">Ventures</a>
        <a href="#about" data-active="false" class="nav-link hover:text-navy transition-colors">About Me</a>
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="nav-link hover:text-navy transition-colors flex items-center gap-1"
            aria-expanded="false"
            aria-controls="dropdown-proof"
            data-dropdown="dropdown-proof"
          >
            {translations.proofInsights || 'Proof & Insights'}
            <svg class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="dropdown-proof"
            class="dropdown-panel absolute top-full left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 -translate-y-1 pointer-events-none transition-all duration-200 ease-out z-50"
          >
            <a href={enProofItems[0].href} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{enProofItems[0].label}</a>
            <a href={enProofItems[1].href} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{enProofItems[1].label}</a>
            <a href={enProofItems[2].href} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{enProofItems[2].label}</a>
          </div>
        </div>
      </nav>
    )}

    <div class="flex items-center gap-3">
      <a href={contactHref} class="hidden sm:inline-flex btn-navy btn-sheen px-6 py-3 rounded-full text-sm font-semibold">
        {translations.contact || 'Contact Me for Advice'}
      </a>
      <a
        href={otherLang}
        class="inline-flex items-center gap-1.5 text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-navy border border-navy/20 rounded-full px-3 py-2 sm:px-4 hover:bg-navy hover:text-white transition-colors"
        aria-label={`Switch to ${otherLangLabel}`}
      >
        <span class="text-base leading-none">{isAr ? '🇬🇧' : '🇸🇦'}</span>
        <span class="inline">{otherLangLabel}</span>
      </a>
      <button
        id="menu-toggle"
        class="xl:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-lg hover:bg-navy/5 transition-colors"
        aria-label={translations.menuOpen || 'Open Menu'}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="w-6 h-0.5 bg-navy transition-transform duration-300"></span>
        <span class="w-6 h-0.5 bg-navy transition-opacity duration-300"></span>
        <span class="w-6 h-0.5 bg-navy transition-transform duration-300"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="xl:hidden overflow-hidden bg-white border-t border-slate-100 text-slate-700 font-medium transition-all duration-300 max-h-0 opacity-0"
  >
    <nav class="px-5 py-4 space-y-1" aria-label="Mobile">
      {isAr ? (
        arLinks.map((link) => (
          <a href={link.href} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">{link.label}</a>
        ))
      ) : (
        <>
          <a href="#home" class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">Home</a>
          <div class="mobile-accordion">
            <button
              type="button"
              class="w-full flex items-center justify-between py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors text-left"
              aria-expanded="false"
              aria-controls="accordion-expertise"
              data-accordion="accordion-expertise"
            >
              <span>{translations.expertise || 'Expertise'}</span>
              <svg class="w-4 h-4 transition-transform duration-300 accordion-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div id="accordion-expertise" class="accordion-panel max-h-0 overflow-hidden transition-all duration-300">
              <a href="#executive-roles" class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Current Executive & Advisory Roles</a>
              <a href="#services" class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Services</a>
            </div>
          </div>
          <a href="#ventures" class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">Ventures</a>
          <a href="#about" class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">About Me</a>
          <div class="mobile-accordion">
            <button
              type="button"
              class="w-full flex items-center justify-between py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors text-left"
              aria-expanded="false"
              aria-controls="accordion-proof"
              data-accordion="accordion-proof"
            >
              <span>{translations.proofInsights || 'Proof & Insights'}</span>
              <svg class="w-4 h-4 transition-transform duration-300 accordion-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div id="accordion-proof" class="accordion-panel max-h-0 overflow-hidden transition-all duration-300">
              <a href="#stanford" class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Stanford / Credentials</a>
              <a href="#books" class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">My Books</a>
              <a href="#success" class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Success Stories</a>
            </div>
          </div>
        </>
      )}
      <div class="pt-3 mt-2 border-t border-slate-100 sm:hidden">
        <a href={contactHref} class="btn-navy btn-sheen block text-center px-6 py-3 rounded-full text-sm font-semibold">
          {translations.contact || 'Contact Me for Advice'}
        </a>
      </div>
    </nav>
  </div>
</header>
