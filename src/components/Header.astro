---
import { siteConfig } from '../scripts/siteConfig';

interface Props {
  translations?: {
    home?: string;
    about?: string;
    books?: string;
    contact?: string;
    menuOpen?: string;
    menuClose?: string;
    otherLang?: string;
  };
  currentLang?: string;
}

const {
  translations = {},
  currentLang = 'en'
} = Astro.props;
const lang = currentLang;

const otherLang = currentLang === 'ar' ? '/' : '/ar/';
const otherLangLabel = currentLang === 'ar' ? 'English' : 'العربية';
const navLinks = [
  { href: currentLang === 'ar' ? '/ar/#home' : '#home', label: translations.home || 'Home', id: 'home' },
  { href: currentLang === 'ar' ? '/ar/#services' : '#services', label: currentLang === 'ar' ? 'خدماتنا' : 'Services', id: 'services' },
  { href: currentLang === 'ar' ? '/ar/#about' : '#about', label: translations.about || 'About Me', id: 'about' },
  { href: currentLang === 'ar' ? '/ar/#books' : '#books', label: translations.books || 'My Books', id: 'books' },
  { href: currentLang === 'ar' ? '/ar/#success' : '#success', label: currentLang === 'ar' ? 'قصص النجاح' : 'Success Stories', id: 'success' },
  { href: currentLang === 'ar' ? '/ar/#contact' : '#contact', label: translations.contact || 'Contact', id: 'contact' }
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md transition-all duration-300">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 flex items-center justify-between h-20">
    <a href={currentLang === 'ar' ? '/ar/' : '/'} class="flex items-center gap-3 group">
      <span class="w-11 h-11 rounded-full navy-grad flex items-center justify-center text-white font-bold text-lg transition-transform duration-500 group-hover:rotate-6 group-hover:scale-105">
        KM
      </span>
      <span class="leading-tight">
        <span class="block font-serif text-lg font-bold text-navy tracking-wide">
          {siteConfig.name}
        </span>
        <span class="block text-[11px] uppercase tracking-[.2em] text-slate-400">
          {lang === 'ar' ? ' مستشار أعمال، دبي' : 'Business Consultant — Dubai'}
        </span>
      </span>
    </a>
    <nav class="hidden lg:flex items-center gap-8 font-medium text-sm text-slate-700" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} data-active="false" class="nav-link hover:text-navy transition-colors">{link.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={currentLang === 'ar' ? '/ar/#contact' : '#contact'} class="hidden sm:inline-flex btn-navy btn-sheen px-6 py-3 rounded-full text-sm font-semibold">
        {translations.contact || 'Contact Me for Advice'}
      </a>
      <a
        href={otherLang}
        class="inline-flex items-center gap-1.5 text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-navy border border-navy/20 rounded-full px-3 py-2 sm:px-4 hover:bg-navy hover:text-white transition-colors"
        aria-label={`Switch to ${otherLangLabel}`}
      >
        <span class="text-base leading-none">{currentLang === 'ar' ? '🇬🇧' : '🇸🇦'}</span>
        <span class="inline">{otherLangLabel}</span>
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-lg hover:bg-navy/5 transition-colors"
        aria-label={translations.menuOpen || 'Open Menu'}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="w-6 h-0.5 bg-navy transition-transform duration-300"></span>
        <span class="w-6 h-0.5 bg-navy transition-opacity duration-300"></span>
        <span class="w-6 h-0.5 bg-navy transition-transform duration-300"></span>
      </button>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden bg-white border-t border-slate-100 text-slate-700 font-medium transition-all duration-300 max-h-0 opacity-0"
  >
    <nav class="px-5 py-4 space-y-1" aria-label="Mobile">
      {navLinks.map((link) => (
        <a href={link.href} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">{link.label}</a>
      ))}
    </nav>
  </div>
</header>