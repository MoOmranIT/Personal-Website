---
import { siteConfig } from '../scripts/siteConfig';
import BrandMark from './brand/BrandMark.astro';

interface Props {
  translations?: {
    home?: string;
    about?: string;
    books?: string;
    contact?: string;
    menuOpen?: string;
    menuClose?: string;
    otherLang?: string;
    expertise?: string;
    proofInsights?: string;
    credentials?: string;
  };
  currentLang?: string;
  languageSwitcherHref?: string;
  blogHref?: string;
  isBlog?: boolean;
}

const {
  translations = {},
  currentLang = 'en',
  languageSwitcherHref,
  blogHref,
  isBlog = false
} = Astro.props;
const lang = currentLang;
const isAr = lang === 'ar';

const otherLang = languageSwitcherHref || (isAr ? (isBlog ? '/blog/' : '/') : (isBlog ? '/ar/blog/' : '/ar/'));
const languageSwitchLabel = isAr ? 'Switch language to English' : 'Switch language to Arabic';
const homeHref = isAr ? '/ar/' : '/';
const sectionHref = (section: string) => {
  const id = section.includes('#') ? section.split('#').pop() : section.replace(/^#/, '');
  if (isAr) return `/ar/#${id}`;
  if (isBlog) return `/#${id}`;
  return `#${id}`;
};

const enSimpleLinks = [
  { href: '#home', label: translations.home || 'Home', id: 'home' },
];

const enExpertiseItems = [
  { href: '#executive-roles', label: 'Current Executive & Advisory Roles', id: 'executive-roles' },
  { href: '#services', label: 'Services', id: 'services' },
  { href: '#training', label: 'Training & Executive Education', id: 'training' },
];

const enProofItems = [
  { href: '#stanford', label: translations.credentials || 'Stanford / Credentials', id: 'stanford' },
  { href: '#books', label: translations.books || 'My Books', id: 'books' },
  { href: '#success', label: 'Success Stories', id: 'success' },
  { href: '#video-testimonials', label: 'Video Testimonials', id: 'video-testimonials' },
  { href: '#professional-portfolio', label: 'Professional Portfolio', id: 'professional-portfolio' }
];

const arExpertiseItems = [
  { href: '/ar/#executive-roles', label: 'المناصب الحالية', id: 'executive-roles' },
  { href: '/ar/#services', label: 'خدماتنا', id: 'services' },
  { href: '/ar/#training', label: 'التدريب والتعليم التنفيذي', id: 'training' },
];

const arProofItems = [
  { href: '/ar/#stanford', label: 'ستانفورد والاعتمادات', id: 'stanford' },
  { href: '/ar/#books', label: translations.books || 'كتبي', id: 'books' },
  { href: '/ar/#success', label: 'قصص النجاح', id: 'success' },
  { href: '/ar/#video-testimonials', label: 'شهادات مصوّرة', id: 'video-testimonials' },
  { href: '/ar/#professional-portfolio', label: 'معرض أعمالي الاحترافي', id: 'professional-portfolio' },
];

const contactHref = isAr ? '/ar/#contact' : (isBlog ? '/#contact' : '#contact');
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md transition-all duration-300">
  <div data-header-bar class="header-bar max-w-[90rem] mx-auto px-5 sm:px-8 flex items-center h-20 gap-2 sm:gap-3">
    <a href={homeHref} class="header-brand group" data-header-brand>
      <BrandMark size="sm" interactive />
      <span class="header-brand__copy">
        <span class="header-brand__name font-serif" data-header-name>
          {isAr ? 'د. خالد المحمد' : siteConfig.name}
        </span>
        <span class="header-brand__subtitle" data-header-subtitle>
          {isAr ? 'مستشار تطوير أعمال في دبي' : 'Strategic Business Development & Marketing Consultant'}
        </span>
      </span>
    </a>

    {isAr ? (
      <nav class="hidden xl:flex items-center gap-[1.15rem] 2xl:gap-7 font-medium text-sm text-slate-700 min-w-0 flex-1 justify-start ms-1 2xl:ms-2" aria-label="Primary">
        <a href={sectionHref('home')} data-active="false" class="nav-link hover:text-navy transition-colors">الرئيسية</a>
        <div class="nav-dropdown relative">
          <button type="button" class="nav-link hover:text-navy transition-colors flex items-center gap-1" aria-expanded="false" aria-controls="dropdown-expertise" data-dropdown="dropdown-expertise">
            الخبرات
            <svg class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </button>
          <div id="dropdown-expertise" class="dropdown-panel absolute top-full right-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 -translate-y-1 pointer-events-none transition-all duration-200 ease-out z-50">
            {arExpertiseItems.map((link) => <a href={sectionHref(link.href)} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{link.label}</a>)}
          </div>
        </div>
        <a href={sectionHref('ventures')} data-active="false" class="nav-link hover:text-navy transition-colors">المشاريع</a>
        <a href={sectionHref('about')} data-active="false" class="nav-link hover:text-navy transition-colors">من أنا</a>
        <div class="nav-dropdown relative">
          <button type="button" class="nav-link hover:text-navy transition-colors flex items-center gap-1" aria-expanded="false" aria-controls="dropdown-proof" data-dropdown="dropdown-proof">
            الإنجازات والرؤى
            <svg class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </button>
          <div id="dropdown-proof" class="dropdown-panel absolute top-full right-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 -translate-y-1 pointer-events-none transition-all duration-200 ease-out z-50">
            {arProofItems.map((link) => <a href={sectionHref(link.href)} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{link.label}</a>)}
          </div>
        </div>
        <a href={blogHref || '/ar/blog/'} aria-current={isBlog ? 'page' : undefined} data-active="false" data-nav-blog class="nav-link nav-link--blog hover:text-navy transition-colors">المدونة</a>
      </nav>
    ) : (
      <nav class="hidden xl:flex items-center gap-[1.15rem] 2xl:gap-7 font-medium text-sm text-slate-700 min-w-0 flex-1 justify-start ms-1 2xl:ms-2" aria-label="Primary">
{enSimpleLinks.map((link) => (
          <a href={sectionHref(link.href)} data-active="false" class="nav-link hover:text-navy transition-colors">{link.label}</a>
        ))}
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="nav-link hover:text-navy transition-colors flex items-center gap-1"
            aria-expanded="false"
            aria-controls="dropdown-expertise"
            data-dropdown="dropdown-expertise"
          >
            {translations.expertise || 'Expertise'}
            <svg class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="dropdown-expertise"
            class="dropdown-panel absolute top-full left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 -translate-y-1 pointer-events-none transition-all duration-200 ease-out z-50"
          >
            {enExpertiseItems.map((item) => <a href={sectionHref(item.href)} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{item.label}</a>)}
          </div>
        </div>
        <a href={sectionHref('ventures')} data-active="false" class="nav-link hover:text-navy transition-colors">Ventures</a>
        <a href={sectionHref('about')} data-active="false" class="nav-link hover:text-navy transition-colors">About Me</a>
        <div class="nav-dropdown relative">
          <button
            type="button"
            class="nav-link hover:text-navy transition-colors flex items-center gap-1"
            aria-expanded="false"
            aria-controls="dropdown-proof"
            data-dropdown="dropdown-proof"
          >
            {translations.proofInsights || 'Proof & Insights'}
            <svg class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            id="dropdown-proof"
            class="dropdown-panel absolute top-full left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 -translate-y-1 pointer-events-none transition-all duration-200 ease-out z-50"
          >
            {enProofItems.map((item) => (
              <a href={sectionHref(item.href)} data-active="false" class="nav-link block py-2.5 px-4 hover:text-navy hover:bg-navy/5 transition-colors">{item.label}</a>
            ))}
          </div>
        </div>
        <a href={blogHref || '/blog/'} aria-current={isBlog ? 'page' : undefined} data-active="false" data-nav-blog class="nav-link nav-link--blog hover:text-navy transition-colors">Blog</a>
      </nav>
    )}

    <div data-header-actions class="header-actions flex items-center gap-2 shrink-0 ps-2 xl:ps-4 2xl:ps-5">
      <a href={contactHref} class="hidden sm:inline-flex btn-navy btn-sheen px-5 py-2.5 rounded-full text-sm font-semibold whitespace-nowrap">
        {translations.contact || 'Contact Me for Advice'}
      </a>
      <a
        href={otherLang}
        data-language-switch
        class="lang-switch-btn inline-flex items-center justify-center rounded-full border border-navy/15 text-navy hover:border-[#c59c07]/45 hover:bg-navy/[0.04] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#c59c07] focus-visible:ring-offset-2 active:scale-[0.98]"
        aria-label={languageSwitchLabel}
        title={languageSwitchLabel}
      >
        <svg class="lang-switch-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c2.6 2.8 4 6 4 9s-1.4 6.2-4 9" />
          <path d="M12 3c-2.6 2.8-4 6-4 9s1.4 6.2 4 9" />
          <path d="M8 7.5h8M7.5 16.5h9" stroke-linecap="round" />
        </svg>
      </a>
      <button
        id="menu-toggle"
        class="xl:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-lg hover:bg-navy/5 transition-colors"
        aria-label={translations.menuOpen || 'Open Menu'}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="w-6 h-0.5 bg-navy transition-transform duration-300"></span>
        <span class="w-6 h-0.5 bg-navy transition-opacity duration-300"></span>
        <span class="w-6 h-0.5 bg-navy transition-transform duration-300"></span>
      </button>
    </div>
  </div>

  <style>
    .header-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
      flex: 1 1 auto;
      container-type: inline-size;
    }

    .header-brand__copy {
      min-width: 0;
    }

    .header-brand__name {
      display: block;
      max-width: 100%;
      white-space: nowrap;
      color: var(--navy);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: 0;
      font-size: clamp(0.65rem, 5.35cqi, 1.125rem);
    }

    .header-brand__subtitle {
      display: block;
      margin-top: 0.12rem;
      color: #94a3b8;
      font-size: 9px;
      font-weight: 500;
      line-height: 1.25;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .header-actions {
      margin-inline-start: auto;
    }

    @media (min-width: 640px) {
      .header-brand {
        gap: 0.625rem;
      }

      .header-brand__subtitle {
        font-size: 11px;
        letter-spacing: 0.08em;
      }
    }

    @media (min-width: 1280px) {
      .header-brand {
        flex: 0 1 auto;
        container-type: normal;
      }

      .header-brand__name {
        font-size: 1.125rem;
        letter-spacing: 0.025em;
      }

      .header-brand__subtitle {
        letter-spacing: 0.16em;
      }
    }

    .lang-switch-btn {
      width: 2.25rem;
      height: 2.25rem;
    }

    .lang-switch-btn__icon {
      width: 1.125rem;
      height: 1.125rem;
    }
  </style>

  <div
    id="mobile-menu"
    class="xl:hidden overflow-hidden bg-white border-t border-slate-100 text-slate-700 font-medium transition-all duration-300 max-h-0 opacity-0"
  >
    <nav class="px-5 py-4 space-y-1" aria-label="Mobile">
      {isAr ? (
        <>
          <a href={sectionHref('home')} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">الرئيسية</a>
          <div class="mobile-accordion">
            <button type="button" class="w-full flex items-center justify-between py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors text-left" aria-expanded="false" aria-controls="accordion-expertise" data-accordion="accordion-expertise"><span>الخبرات</span><svg class="w-4 h-4 transition-transform duration-300 accordion-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg></button>
            <div id="accordion-expertise" class="accordion-panel max-h-0 overflow-hidden transition-all duration-300">{arExpertiseItems.map((link) => <a href={sectionHref(link.href)} class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">{link.label}</a>)}</div>
          </div>
          <a href={sectionHref('ventures')} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">المشاريع</a>
          <a href={sectionHref('about')} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">من أنا</a>
          <div class="mobile-accordion">
            <button type="button" class="w-full flex items-center justify-between py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors text-left" aria-expanded="false" aria-controls="accordion-proof" data-accordion="accordion-proof"><span>الإنجازات والرؤى</span><svg class="w-4 h-4 transition-transform duration-300 accordion-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg></button>
            <div id="accordion-proof" class="accordion-panel max-h-0 overflow-hidden transition-all duration-300">{arProofItems.map((link) => <a href={sectionHref(link.href)} class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">{link.label}</a>)}</div>
          </div>
          <a href={blogHref || '/ar/blog/'} aria-current={isBlog ? 'page' : undefined} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">{isAr ? 'المدونة' : 'Blog'}</a>
        </>
      ) : (
        <>
          <a href={sectionHref('home')} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">Home</a>
          <div class="mobile-accordion">
            <button
              type="button"
              class="w-full flex items-center justify-between py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors text-left"
              aria-expanded="false"
              aria-controls="accordion-expertise"
              data-accordion="accordion-expertise"
            >
              <span>{translations.expertise || 'Expertise'}</span>
              <svg class="w-4 h-4 transition-transform duration-300 accordion-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
               <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
            <div id="accordion-expertise" class="accordion-panel max-h-0 overflow-hidden transition-all duration-300">
              <a href={sectionHref('executive-roles')} class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Current Executive & Advisory Roles</a>
              <a href={sectionHref('services')} class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Services</a>
              <a href={sectionHref('training')} class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">Training & Executive Education</a>
            </div>
          </div>
          <a href={sectionHref('ventures')} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">Ventures</a>
          <a href={sectionHref('about')} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">About Me</a>
          <div class="mobile-accordion">
            <button
              type="button"
              class="w-full flex items-center justify-between py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors text-left"
              aria-expanded="false"
              aria-controls="accordion-proof"
              data-accordion="accordion-proof"
            >
              <span>{translations.proofInsights || 'Proof & Insights'}</span>
              <svg class="w-4 h-4 transition-transform duration-300 accordion-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>
             <div id="accordion-proof" class="accordion-panel max-h-0 overflow-hidden transition-all duration-300">
               {enProofItems.map((item) => <a href={sectionHref(item.href)} class="block py-2.5 pl-6 pr-3 text-sm text-slate-600 hover:text-navy hover:bg-navy/5 transition-colors">{item.label}</a>)}
             </div>

          </div>
          <a href={blogHref || '/blog/'} aria-current={isBlog ? 'page' : undefined} class="block py-3 px-3 rounded-lg hover:text-navy hover:bg-navy/5 transition-colors">Blog</a>
        </>
      )}
      <div class="pt-3 mt-2 border-t border-slate-100 sm:hidden">
        <a href={contactHref} class="btn-navy btn-sheen block text-center px-6 py-3 rounded-full text-sm font-semibold">
          {translations.contact || 'Contact Me for Advice'}
        </a>
      </div>
    </nav>
  </div>
</header>
