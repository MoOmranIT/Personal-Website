---
interface Props {
  translations?: {
    services?: {
      section1?: {
        id?: string;
        title?: string;
        heading?: string;
        description?: string;
        points?: string[];
        cta?: string;
      };
      section2?: {
        id?: string;
        title?: string;
        heading?: string;
        description?: string;
        points?: string[];
        cta?: string;
      };
    };
  };
  lang?: string;
}

const { translations = {}, lang = 'en' } = Astro.props;
const t = translations.services || {};

const services = [
  {
    id: t.section1?.id ?? '01',
    title: t.section1?.title ?? 'Development',
    heading: t.section1?.heading ?? 'Grow Your Business',
    description: t.section1?.description ?? 'We deliver specialized training for business development to elevate performance and achieve sustainable growth. Our focus is on strengthening managerial and marketing capabilities to secure the success of your projects in both local and global markets.',
    points: t.section1?.points ?? [
      'Executive management & leadership development',
      'Digital marketing & brand positioning',
      'Local and international market expansion'
    ],
    cta: t.section1?.cta ?? 'Book a Session',
    icon: '📈',
    variant: 'light'
  },
  {
    id: t.section2?.id ?? '02',
    title: t.section2?.title ?? 'Transformation',
    heading: t.section2?.heading ?? 'Rise Like a Phoenix',
    description: t.section2?.description ?? 'We analyze complex institutional challenges and design tailor-made strategic solutions to secure the continuity of your business. Don\'t miss the opportunity or waste another minute — the time to act is now.',
    points: t.section2?.points ?? [
      'Crisis management & institutional turnaround',
      'Custom strategic roadmaps',
      'Business continuity assurance'
    ],
    cta: t.section2?.cta ?? 'Book a Session',
    icon: '🔥',
    variant: 'dark'
  }
];
---

<section id="services" class="relative bg-slate-50">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-24">
    <div class="text-center mb-16 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-slate-400 mb-3 block">
        {lang === 'ar' ? 'خدماتنا' : 'Our Services'}
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-navy title-underline inline-block">
        {lang === 'ar' ? 'كيف نساعد شركتك على النمو' : 'How We Drive Your Growth'}
      </h2>
    </div>
    <div class="grid lg:grid-cols-2 gap-8">
      {services.map((service, i) => (
        <div class={`reveal ${i === 1 ? 'delay-2' : ''} ${service.variant === 'dark' ? 'navy-grad text-white rounded-3xl p-8 sm:p-12' : 'bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-slate-100'}`}>
          <div class="flex items-start justify-between gap-4 mb-6">
            <span class="text-xs uppercase tracking-[.3em] text-slate-400">
              {service.id} — {service.title}
            </span>
            <span class="text-3xl">{service.icon}</span>
          </div>
          <h3 class="text-3xl sm:text-4xl font-bold text-navy mb-6 leading-tight" set:html={service.heading.replace(/Phoenix/g, '<span class="gold">Phoenix</span>')} />
          {service.description && (
            <p class={`text-lg leading-relaxed mb-8 ${service.variant === 'dark' ? 'text-white/80' : 'text-slate-600'}`}>
              {service.description}
            </p>
          )}
          {service.points.length > 0 && (
            <ul class="space-y-4 mb-10">
              {service.points.map((point) => (
                <li class="flex items-start gap-3 group">
                  <span class={`w-2 h-2 mt-2 rounded-full shrink-0 transition-transform duration-300 group-hover:scale-150 ${service.variant === 'dark' ? 'bg-gold' : 'bg-navy'}`}></span>
                  <span class={`transition-colors duration-300 group-hover:text-navy ${service.variant === 'dark' ? 'text-white/80 group-hover:text-white' : 'text-slate-600'}`} set:html={point} />
                </li>
              ))}
            </ul>
          )}
          <a href={lang === 'ar' ? '/ar/#contact' : '#contact'} class={`inline-flex items-center gap-2 font-semibold px-7 py-3.5 rounded-full transition-all ${service.variant === 'dark' ? 'bg-white text-navy hover:bg-gold hover:text-white hover:-translate-y-0.5' : 'btn-outline'}`}>
            {service.cta}
            <span>{lang === 'ar' ? '←' : '→'}</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>