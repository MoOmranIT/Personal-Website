---
interface Props {
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  interactive?: boolean;
}

const {
  variant = 'dark',
  size = 'sm',
  class: className,
  interactive = false,
} = Astro.props;

const sizeClass = {
  sm: 'brand-mark--sm',
  md: 'brand-mark--md',
  lg: 'brand-mark--lg',
}[size];

const src = variant === 'light'
  ? '/brand/dr-khaled-monogram-light.webp'
  : '/brand/dr-khaled-monogram-dark.webp';
---

<span
  class:list={[
    'brand-mark',
    sizeClass,
    variant === 'light' ? 'brand-mark--light' : 'brand-mark--dark',
    interactive && 'brand-mark--interactive',
    className,
  ]}
  data-brand-mark
  data-brand-variant={variant}
  aria-hidden="true"
>
  <img
    class="brand-mark__img"
    src={src}
    alt=""
    width="171"
    height="231"
    decoding="async"
  />
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    aspect-ratio: 171 / 231;
  }

  .brand-mark--sm {
    height: 2.25rem;
  }

  .brand-mark--md {
    height: 2.85rem;
  }

  .brand-mark--lg {
    height: 3.35rem;
  }

  .brand-mark__img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .brand-mark--interactive {
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(a:hover) .brand-mark--interactive {
      opacity: 0.94;
      filter: drop-shadow(0 0 0.35rem rgba(197, 156, 7, 0.22));
    }
  }
</style>
