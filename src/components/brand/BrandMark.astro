---
interface Props {
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  interactive?: boolean;
}

const {
  variant = 'dark',
  size = 'sm',
  class: className,
  interactive = false,
} = Astro.props;

const sizeClass = {
  sm: 'brand-mark--sm',
  md: 'brand-mark--md',
  lg: 'brand-mark--lg',
}[size];

const stroke = variant === 'light' ? '#f8f7f3' : '#0b1c39';
---

<span
  class:list={[
    'brand-mark',
    sizeClass,
    variant === 'light' ? 'brand-mark--light' : 'brand-mark--dark',
    interactive && 'brand-mark--interactive',
    className,
  ]}
  data-brand-mark
  data-brand-variant={variant}
  aria-hidden="true"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none" class="brand-mark__svg">
    <path d="M32 5 54.5 17.2v29.6L32 59 9.5 46.8V17.2L32 5z" stroke={stroke} stroke-width="2.15" stroke-linejoin="round"/>
    <path d="M32 5 54.5 17.2 32 29.4 9.5 17.2 32 5z" stroke="#c59c07" stroke-width="1.05" stroke-linejoin="round" opacity="0.92"/>
    <path d="M22.5 14.5v35" stroke={stroke} stroke-width="2.35" stroke-linecap="round"/>
    <path d="M22.5 32 41.5 14.5" stroke={stroke} stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M22.5 32 41.5 49.5" stroke={stroke} stroke-width="2.35" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M36.5 14.5v35" stroke={stroke} stroke-width="2.15" stroke-linecap="round"/>
    <path d="M36.5 14.5 48.5 32 36.5 49.5" stroke={stroke} stroke-width="2.15" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-mark--sm {
    width: 2.25rem;
    height: 2.25rem;
  }

  .brand-mark--md {
    width: 2.5rem;
    height: 2.5rem;
  }

  .brand-mark--lg {
    width: 3.5rem;
    height: 3.5rem;
  }

  .brand-mark__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .brand-mark--interactive {
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(a:hover) .brand-mark--interactive {
      opacity: 0.94;
      filter: drop-shadow(0 0 0.35rem rgba(197, 156, 7, 0.22));
    }
  }
</style>
