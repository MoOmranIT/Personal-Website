---
import BrandMark from './BrandMark.astro';
---

<div class="executive-brand-mark" data-executive-brand-mark>
  <div class="executive-brand-mark__surface">
    <div class="executive-brand-mark__sheen" aria-hidden="true"></div>
    <BrandMark variant="light" size="lg" />
  </div>
</div>

<style>
  .executive-brand-mark {
    --pointer-x: 50%;
    --pointer-y: 50%;
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    perspective: 900px;
  }

  .executive-brand-mark__surface {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1rem;
    background: linear-gradient(145deg, rgba(11, 28, 57, 0.96), rgba(11, 28, 57, 0.82));
    border: 1px solid rgba(197, 156, 7, 0.28);
    box-shadow:
      0 14px 28px -18px rgba(11, 28, 57, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: rotateX(var(--tilt-y)) rotateY(var(--tilt-x));
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    overflow: hidden;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    animation: executive-brand-reveal 1.1s ease forwards;
  }

  .executive-brand-mark__sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(255, 255, 255, 0.16), transparent 42%),
      linear-gradient(115deg, transparent 42%, rgba(197, 156, 7, 0.14) 50%, transparent 58%);
    opacity: 0.55;
  }

  .executive-brand-mark.is-ready .executive-brand-mark__surface {
    opacity: 1;
    clip-path: inset(0 0 0 0);
  }

  @keyframes executive-brand-reveal {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0);
      transform: rotateX(0deg) rotateY(0deg) translateX(-6px);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
      transform: rotateX(var(--tilt-y)) rotateY(var(--tilt-x)) translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .executive-brand-mark__surface {
      animation: none;
      opacity: 1;
      clip-path: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const roots = document.querySelectorAll('[data-executive-brand-mark]');

  for (const root of roots) {
    const surface = root.querySelector('.executive-brand-mark__surface') as HTMLElement | null;
    if (!surface) continue;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    root.classList.add('is-ready');

    if (reducedMotion || !finePointer) continue;

    const maxTilt = 3.5;

    const setPointer = (clientX: number, clientY: number) => {
      const rect = surface.getBoundingClientRect();
      const x = ((clientX - rect.left) / rect.width) * 100;
      const y = ((clientY - rect.top) / rect.height) * 100;
      root.style.setProperty('--pointer-x', `${Math.min(100, Math.max(0, x))}%`);
      root.style.setProperty('--pointer-y', `${Math.min(100, Math.max(0, y))}%`);
      const tiltX = ((x - 50) / 50) * maxTilt;
      const tiltY = ((50 - y) / 50) * maxTilt;
      root.style.setProperty('--tilt-x', `${tiltX.toFixed(2)}deg`);
      root.style.setProperty('--tilt-y', `${tiltY.toFixed(2)}deg`);
    };

    const resetPointer = () => {
      root.style.setProperty('--pointer-x', '50%');
      root.style.setProperty('--pointer-y', '50%');
      root.style.setProperty('--tilt-x', '0deg');
      root.style.setProperty('--tilt-y', '0deg');
    };

    surface.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      setPointer(event.clientX, event.clientY);
    });

    surface.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      setPointer(event.clientX, event.clientY);
    });

    surface.addEventListener('pointerleave', resetPointer);
  }
</script>
