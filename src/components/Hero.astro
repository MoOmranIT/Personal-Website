---
const heroImage = '/images/heroo.webp';

interface Props {
  translations?: {
    hero?: {
      badge?: string;
      heading?: string;
      headingHighlight?: string;
      description?: string;
      ctaPrimary?: string;
      ctaSecondary?: string;
      stat1Label?: string;
      stat2Label?: string;
      stat3Label?: string;
      bottomCta?: string;
    };
  };
  lang?: string;
}

const { translations = {}, lang = 'en' } = Astro.props;
const t = translations.hero || {};
const arrow = lang === 'ar' ? '←' : '→';
const isAr = lang === 'ar';
const headingClass = `reveal delay-2 font-bold text-navy mb-6 tracking-tight hero-heading${isAr ? ' hero-heading--ar text-[2.55rem] sm:text-5xl lg:text-[3.35rem]' : ' text-4xl sm:text-5xl lg:text-[3.6rem] leading-[1.05]'}`;
---

<section id="home" class="hero-pattern relative pt-32 pb-24 lg:pt-44 lg:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-16 lg:gap-20 items-center lg:items-start">
    <div>
      <span class="reveal delay-1 inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-navy/5 text-navy text-xs font-semibold tracking-widest uppercase mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-[#c59c07]"></span>
        {t.badge || 'Strategic Business Consulting'}
      </span>
      <h1 class={headingClass}>
        {t.heading || 'Turning Business Strategy Into'}{t.headingHighlight && <span class={`text-[#c59c07]${isAr ? ' hero-heading-highlight--ar' : ''}`}> {t.headingHighlight}</span>}
      </h1>
      <div class={`reveal delay-3 text-slate-600 text-lg mb-10 max-w-xl${isAr ? ' hero-description--ar' : ' leading-relaxed'}`} set:html={t.description || 'I work at the intersection of strategy, growth, marketing, and leadership, helping organizations turn business challenges into clear strategies, stronger opportunities, and measurable results.<br />My experience spans executive leadership, strategic advisory, business development, training, and venture building across the UAE and beyond.'} />
      <div class={`reveal delay-4 flex gap-4${isAr ? ' flex-col items-stretch sm:items-start' : ' flex-wrap items-center'}`}>
        <a href={lang === 'ar' ? '/ar/#contact' : '#contact'} class={`btn-navy btn-sheen px-8 py-4 rounded-full font-semibold text-base shadow-lg${isAr ? ' w-full sm:w-auto' : ''}`}>
          {t.ctaPrimary || 'Book a Strategic Consultation'}
        </a>
        <a href={lang === 'ar' ? '/ar/#success' : '#about'} class={`btn-outline px-8 py-4 rounded-full font-semibold text-base flex items-center gap-2${isAr ? ' w-full sm:w-auto' : ''}`}>
          {t.ctaSecondary || 'Explore My Executive Profile'} <span class="cta-arrow">{arrow}</span>
        </a>
      </div>
    </div>
    <div class="reveal-right delay-6 relative lg:pt-20">
      <div class="w-full max-w-md mx-auto relative">
        <div aria-hidden="true" class="absolute -inset-3 rounded-[2.6rem] border border-[#c59c07]/25 pointer-events-none"></div>
        <div aria-hidden="true" class="absolute -inset-1 rounded-[2.5rem] bg-navy-soft/10 pointer-events-none"></div>
        <img
          src={heroImage}
          alt="Dr. Khaled Al Mohammad, Business Consultant in Dubai"
          width="800"
          height="800"
          class="relative rounded-[2.5rem] w-full max-w-md mx-auto aspect-square object-cover object-top shadow-2xl parallax-img"
          loading="eager"
          fetchPriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
  <div class="max-w-4xl mx-auto px-5 mt-20 text-center reveal delay-3">
    <a
      href={lang === 'ar' ? '/ar/#contact' : '#success'}
      class="inline-flex btn-navy btn-sheen px-10 py-5 rounded-full font-bold text-lg tracking-wide shadow-xl"
    >
      {t.bottomCta || '🏆 Enter the Race for First Place'}
    </a>
  </div>
</section>

<style>
  .hero-heading {
    position: relative;
    display: inline-block;
  }
  .hero-heading::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #c59c07, var(--navy-soft), #c59c07);
    border-radius: 2px;
    opacity: 0.85;
  }

  .hero-heading--ar {
    line-height: 1.25;
  }

  .hero-heading-highlight--ar {
    display: block;
    margin-top: 0.16em;
  }

  .hero-heading--ar::after {
    bottom: -14px;
  }

  .hero-description--ar {
    line-height: 1.85;
  }

  @media (min-width: 1024px) {
    .hero-heading--ar {
      line-height: 1.18;
    }
  }
</style>
