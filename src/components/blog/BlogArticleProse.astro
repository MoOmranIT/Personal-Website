---
interface Props {
  isAr?: boolean;
}

const { isAr = false } = Astro.props;
---

<div
  class:list={['blog-article-prose', 'blog-article-body', { 'blog-article-prose--ar': isAr }]}
  data-article-prose
>
  <slot />
</div>

<style>
  .blog-article-prose {
    max-width: 48rem;
    margin: 4rem auto 0;
    color: #334155;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .blog-article-prose :global(p) {
    margin-top: 1.5rem;
  }

  .blog-article-prose :global(p:first-child) {
    margin-top: 0;
  }

  .blog-article-prose :global(h2) {
    margin-top: 3.25rem;
    color: #0b1c39;
    font-size: 1.8rem;
    line-height: 1.25;
  }

  .blog-article-prose :global(h3) {
    margin-top: 2.5rem;
    color: #0b1c39;
    font-size: 1.35rem;
  }

  .blog-article-prose :global(ul),
  .blog-article-prose :global(ol) {
    margin-top: 1.25rem;
    padding-inline-start: 1.5rem;
  }

  .blog-article-prose :global(li) {
    margin-top: 0.55rem;
  }

  .blog-article-prose :global(blockquote) {
    position: relative;
    margin: 2.35rem 0;
    padding: 1.45rem 1.55rem 1.5rem;
    padding-inline-start: 1.7rem;
    border-radius: 0.875rem;
    border: 1px solid rgba(11, 28, 57, 0.11);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(197, 156, 7, 0.055), transparent 55%),
      linear-gradient(180deg, rgba(255, 252, 245, 0.98), rgba(247, 244, 236, 0.94));
    color: #0b1c39;
    font-style: normal;
    box-shadow: 0 14px 36px -30px rgba(11, 28, 57, 0.42);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease,
      background 0.22s ease;
  }

  .blog-article-prose :global(blockquote::before) {
    content: '';
    position: absolute;
    inset-inline-start: 0.55rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(197, 156, 7, 0.92), rgba(197, 156, 7, 0.28));
    pointer-events: none;
  }

  .blog-article-prose :global(blockquote p) {
    margin: 0.85rem 0 0;
    color: #334155;
    font-weight: 400;
    line-height: 1.72;
  }

  .blog-article-prose :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .blog-article-prose :global(blockquote p:first-child:not(:last-child)) {
    color: #0b1c39;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .blog-article-prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .blog-article-prose :global(.blog-article-inline-image) {
    margin: 2.25rem 0;
  }

  .blog-article-prose :global(.blog-article-inline-image img) {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid rgba(11, 28, 57, 0.08);
    box-shadow: 0 20px 48px -34px rgba(11, 28, 57, 0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .blog-article-prose :global(a) {
    color: #0b1c39;
    text-decoration: underline;
    text-decoration-color: #c59c07;
    text-underline-offset: 3px;
  }

  .blog-article-prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid rgba(11, 28, 57, 0.12);
  }

  .blog-article-prose :global(blockquote:focus-within) {
    border-color: rgba(11, 28, 57, 0.16);
    box-shadow: 0 18px 42px -28px rgba(11, 28, 57, 0.48);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(197, 156, 7, 0.075), transparent 55%),
      linear-gradient(180deg, rgba(255, 253, 247, 1), rgba(248, 245, 236, 0.96));
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-article-prose :global(blockquote:hover) {
      transform: translateY(-1px);
      border-color: rgba(11, 28, 57, 0.16);
      box-shadow: 0 18px 42px -28px rgba(11, 28, 57, 0.48);
      background:
        radial-gradient(120% 140% at 100% 0%, rgba(197, 156, 7, 0.075), transparent 55%),
        linear-gradient(180deg, rgba(255, 253, 247, 1), rgba(248, 245, 236, 0.96));
    }

    .blog-article-prose :global(.blog-article-inline-image:hover img) {
      transform: scale(1.005);
      box-shadow: 0 24px 52px -34px rgba(11, 28, 57, 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-article-prose :global(blockquote),
    .blog-article-prose :global(.blog-article-inline-image img) {
      transition: none;
      transform: none;
    }
  }

  .blog-article-prose--ar {
    line-height: 1.95;
  }

  @media (max-width: 639px) {
    .blog-article-prose {
      margin-top: 2.75rem;
      font-size: 1rem;
    }

    .blog-article-prose :global(blockquote) {
      margin: 2rem 0;
      padding: 1.2rem 1.15rem 1.25rem;
      padding-inline-start: 1.45rem;
    }
  }
</style>
