---
interface Props {
  articles: any[];
  lang: 'en' | 'ar';
  labels: {
    read: string;
    indicator: string;
  };
}

const { articles, lang, labels } = Astro.props;
---

<section class="blog-featured" data-featured-slider data-lang={lang} aria-label={lang === 'ar' ? 'المقالات المميزة' : 'Featured articles'}>
  <div class="blog-featured-slides">
    {articles.map((article, index) => (
      <article id={`featured-slide-${lang}-${index}`} class:list={['blog-featured-slide', { 'is-active': index === 0 }]} data-featured-slide={index} aria-hidden={index === 0 ? 'false' : 'true'}>
        <div class="blog-featured-copy">
          <span class="blog-category">{article.data.category}</span>
          <h2>{article.data.title}</h2>
          <p>{article.data.excerpt}</p>
          <a class="blog-visual-cta" href={`${lang === 'ar' ? '/ar/blog' : '/blog'}/${article.data.slug}/`}>{labels.read} <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a>
        </div>
        <div class="blog-featured-media">
          <img src={article.data.image} alt={article.data.imageAlt} width="1200" height="750" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
      </article>
    ))}
  </div>
  <div class="blog-featured-indicators" role="tablist" aria-label={lang === 'ar' ? 'المقالات المميزة' : 'Featured article slides'}>
    {articles.map((article, index) => (
      <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`featured-slide-${lang}-${index}`} aria-label={`${labels.indicator} ${index + 1}`} data-featured-indicator={index} class:is-active={index === 0}></button>
    ))}
  </div>
</section>

<script>
  const sliders = document.querySelectorAll<HTMLElement>('[data-featured-slider]');
  sliders.forEach((slider) => {
    const slides = [...slider.querySelectorAll<HTMLElement>('[data-featured-slide]')];
    const indicators = [...slider.querySelectorAll<HTMLButtonElement>('[data-featured-indicator]')];
    if (slides.length < 2) return;
    let active = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let paused = false;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (index: number) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const selected = i === active;
        slide.classList.toggle('is-active', selected);
        slide.setAttribute('aria-hidden', selected ? 'false' : 'true');
      });
      indicators.forEach((indicator, i) => {
        const selected = i === active;
        indicator.classList.toggle('is-active', selected);
        indicator.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (!reduced && !paused && document.visibilityState === 'visible') {
        timer = setInterval(() => show(active + 1), 3000);
      }
    };

    indicators.forEach((indicator, index) => indicator.addEventListener('click', () => { show(index); start(); }));
    slider.addEventListener('focusin', () => { paused = true; stop(); });
    slider.addEventListener('focusout', (event) => {
      if (!slider.contains(event.relatedTarget as Node | null)) { paused = false; start(); }
    });
    document.addEventListener('visibilitychange', start);
    slider.dataset.featuredSliderReady = 'true';
    start();
  });
</script>

<style>
  .blog-featured { position: relative; height: clamp(34rem, 37vw, 38rem); }
  .blog-featured-slides { display: grid; height: clamp(34rem, 37vw, 38rem); min-height: 0; }
  .blog-featured-slide { grid-area: 1 / 1; display: grid; min-width: 0; min-height: 0; height: 100%; grid-template-columns: .85fr 1.15fr; gap: clamp(1.25rem, 3vw, 3.5rem); overflow: hidden; border-radius: 2rem; background: radial-gradient(ellipse at 88% 112%, rgba(70, 117, 226, .92) 0%, rgba(86, 132, 231, .68) 24%, rgba(86, 132, 231, 0) 61%), linear-gradient(135deg, #f6fbfd 0%, #e9f4f8 48%, #cfe0ee 100%); opacity: 0; visibility: hidden; pointer-events: none; transform: translateX(14px); transition: opacity .52s ease, visibility .52s ease, transform .52s ease; }
  .blog-featured-slide.is-active { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(0); z-index: 1; }
  .blog-featured-copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 3vw, 3rem) clamp(2.25rem, 5vw, 5rem); color: #0b1c39; }
  .blog-category { color: #b28700; font-size: .7rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .blog-featured-copy h2 { max-width: 39rem; margin-top: .8rem; color: #0b1c39; font-size: clamp(2.6rem, 3.5vw, 3.8rem); font-weight: 700; line-height: 1.08; }
  .blog-featured-copy p { max-width: 34rem; margin-top: 1rem; color: #40546a; font-size: clamp(1.05rem, 1.2vw, 1.15rem); line-height: 1.55; }
  .blog-visual-cta { display: inline-flex; align-items: center; gap: .75rem; align-self: flex-start; min-height: 3.25rem; margin-top: 1.5rem; padding: .75rem 1.75rem; border-radius: 999px; background: #0b1c39; color: #fff; font-size: .9rem; font-weight: 700; box-shadow: 0 10px 24px -18px rgba(11, 28, 57, .8); transition: transform .2s ease, background-color .2s ease; }
  .blog-visual-cta:hover { transform: translateY(-2px); background: #132b51; }
  .blog-visual-cta:focus-visible { outline: 3px solid #b28700; outline-offset: 4px; }
  .blog-visual-cta span { display: inline-grid; width: 1.35rem; height: 1.35rem; place-items: center; border-radius: 50%; background: rgba(255, 255, 255, .16); }
  .blog-featured-media { min-width: 0; min-height: 0; align-self: stretch; overflow: hidden; margin-block: 2.5rem 5.75rem; margin-inline-end: 2.75rem; border-radius: 2rem; background: #d8e3eb; }
  .blog-featured-media img { width: 100%; height: 100%; min-height: 0; object-fit: cover; object-position: center top; }
  .blog-featured-indicators { position: absolute; bottom: 1.25rem; left: 50%; z-index: 2; display: flex; justify-content: center; gap: .6rem; transform: translateX(-50%); }
  .blog-featured-indicators button { width: 1.25rem; height: .375rem; padding: 0; border: 0; border-radius: 999px; background: rgba(255, 255, 255, .55); cursor: pointer; transition: background-color .2s ease, width .2s ease; }
  .blog-featured-indicators button.is-active { width: 3.1rem; background: rgba(255, 255, 255, .98); }
  .blog-featured-indicators button:focus-visible { outline: 2px solid #b28700; outline-offset: 4px; }
  [dir='rtl'] .blog-featured { direction: rtl; }
  [dir='rtl'] .blog-featured-copy { text-align: right; }
  [dir='rtl'] .blog-visual-cta { align-self: flex-start; }
  @media (max-width: 1023px) {
    .blog-featured { height: 38rem; }
    .blog-featured-slides { height: 38rem; min-height: 0; }
    .blog-featured-slide { height: 38rem; grid-template-columns: .9fr 1.1fr; }
    .blog-featured-copy { padding: 2rem; }
    .blog-featured-copy h2 { font-size: clamp(2.3rem, 5vw, 3.4rem); }
  }
  @media (max-width: 767px) {
    .blog-featured { height: 39rem; }
    .blog-featured-slides { height: 39rem; min-height: 0; }
    .blog-featured-slide { height: 39rem; grid-template-columns: 1fr; grid-template-rows: 15rem 1fr; gap: 0; padding: .75rem; }
    .blog-featured-media { order: -1; margin: 0; border-radius: 1.25rem; }
    .blog-featured-copy { padding: 1.5rem 1rem 2.25rem; }
    .blog-featured-copy h2 { font-size: clamp(2rem, 8vw, 2.4rem); line-height: 1.12; }
    .blog-featured-copy p { font-size: 1rem; line-height: 1.65; }
    .blog-visual-cta { min-height: 3rem; margin-top: 1.5rem; padding-inline: 1.4rem; }
    .blog-featured-indicators { bottom: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-featured-slide, .blog-featured-indicators button, .blog-visual-cta { transition: none; }
  }
</style>
