---
import FeaturedBlogSlider from './FeaturedBlogSlider.astro';

interface Props {
  articles: any[];
  lang: 'en' | 'ar';
}

const { articles, lang } = Astro.props;
const featured = articles.filter((article) => article.data.featured).sort((a, b) => (a.data.featuredOrder || 99) - (b.data.featuredOrder || 99)).slice(0, 3);
const regular = articles.filter((article) => !article.data.featured).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const labels = lang === 'ar'
  ? { read: 'اقرأ المقال', more: 'اقرأ المزيد', indicator: 'عرض المقال المميز' }
  : { read: 'Read Article', more: 'Read more', indicator: 'Show featured article' };
---

<main id="main" class="blog-page" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <div class="blog-landing-shell">
    <FeaturedBlogSlider articles={featured} lang={lang} labels={labels} />

    <section class="blog-grid-section" aria-labelledby="blog-grid-heading">
      <div class="blog-grid-heading-row">
        <div>
          <span class="blog-grid-eyebrow">{lang === 'ar' ? 'استكشف المعرفة' : 'LATEST THINKING'}</span>
          <h1 id="blog-grid-heading">{lang === 'ar' ? 'تصفح المقالات' : 'Browse Our Articles'}</h1>
        </div>
      </div>
      <div class="blog-grid">
        {regular.map((article) => (
          <article class="blog-card reveal">
            <div class="blog-card-media"><img src={article.data.image} alt={article.data.imageAlt} width="800" height="520" loading="lazy" decoding="async" /></div>
            <div class="blog-card-body">
              <span class="blog-card-category">{article.data.category}</span>
              <h2>{article.data.title}</h2>
              <a class="blog-card-cta" href={`${lang === 'ar' ? '/ar/blog' : '/blog'}/${article.data.slug}/`}>{labels.more} <span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</main>

<style>
  .blog-page { min-height: 100vh; background: #f7fafc; color: #0b1c39; }
  .blog-landing-shell { width: min(100% - 3rem, 1720px); margin: 0 auto; padding: 7rem 0 4.5rem; }
  .blog-grid-section { width: min(100%, 1280px); margin: clamp(3rem, 4vw, 4rem) auto 0; }
  .blog-grid-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem; }
  .blog-grid-eyebrow { display: block; color: #b28700; font-size: .7rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .blog-grid-section h1 { margin-top: .7rem; color: #0b1c39; font-size: clamp(2rem, 4vw, 3.4rem); font-weight: 700; line-height: 1.1; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .blog-card { display: flex; min-width: 0; flex-direction: column; overflow: visible; border-radius: 1.15rem; background: transparent; transition: transform .3s ease; }
  .blog-card:hover { transform: translateY(-3px); }
  .blog-card-media { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 1.15rem; background: #e7edf3; }
  .blog-card-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .blog-card:hover .blog-card-media img { transform: scale(1.02); }
  .blog-card-body { position: relative; z-index: 1; display: flex; flex: 1; flex-direction: column; margin: -1rem .75rem 0; padding: 1.25rem 1.35rem 1.35rem; border: 1px solid rgba(11, 28, 57, .06); border-radius: 1rem; background: #fff; box-shadow: 0 14px 30px -28px rgba(11, 28, 57, .7); }
  .blog-card-category { color: #b28700; font-size: .66rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .blog-card-body h2 { margin-top: .55rem; color: #0b1c39; font-size: 1.08rem; font-weight: 700; line-height: 1.3; }
  .blog-card-cta { margin-top: 1.1rem; color: #0b1c39; font-size: .82rem; font-weight: 700; }
  .blog-card-cta span { color: #b28700; }
  [dir='rtl'] .blog-page { direction: rtl; }
  [dir='rtl'] .blog-card-body { text-align: right; }
  @media (max-width: 1023px) {
    .blog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 639px) {
    .blog-landing-shell { width: min(100% - 2rem, 1720px); padding-top: 6.5rem; }
    .blog-grid-section { margin-top: 2.75rem; }
    .blog-grid-heading-row { margin-bottom: 1.5rem; }
    .blog-grid { grid-template-columns: 1fr; gap: 1.25rem; }
    .blog-grid-section h1 { font-size: 2.2rem; }
    .blog-card-body { margin-inline: .5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .blog-card, .blog-card-media img { transition: none; } }
</style>
