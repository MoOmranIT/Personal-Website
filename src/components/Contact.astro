---
import { siteConfig } from '../scripts/siteConfig';

interface Props {
  translations?: {
    contact?: {
      badge?: string;
      heading?: string;
      description?: string;
      cards?: {
        whatsapp?: { title?: string; description?: string };
        email?: { title?: string; description?: string };
        phone?: { title?: string; description?: string };
        office?: { title?: string; description?: string };
      };
    };
  };
  lang?: string;
}

const { translations = {}, lang = 'en' } = Astro.props;
const t = translations.contact || {};
const displayPhone = '+971 55 343 3150';
const contactArrow = lang === 'ar' ? '←' : '→';
---

<section id="contact" class="py-24 navy-grad text-white relative overflow-hidden">
  <div class="hidden lg:block absolute -top-20 -right-20 w-96 h-96 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 relative">
    <div class="text-center mb-16 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-white/50 mb-3 block">
        {t.badge || "Let's Talk"}
      </span>
<h2 class="text-4xl sm:text-5xl font-bold mb-4 text-white" set:html={(lang === 'ar'
  ? 'جاهز لبدء <span class="gold">استشارتك</span>؟'
  : 'Ready to Start Your <span class="gold">Consultation?</span>')}></h2>
      <p class="text-white/70 max-w-2xl mx-auto">
        {t.description || 'Reach out directly — I personally review every inquiry and respond within 24 hours.'}
      </p>
    </div>
    <div class="max-w-xl mx-auto">
      {lang === 'en' && (
        <div class="reveal mb-8">
          <a
            href="https://maps.app.goo.gl/gueak6ZVLNiN3eAF6"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open Dubai office location in Google Maps"
            class="dubai-office-card block bg-[#f7f6f2] rounded-3xl border border-gold/30 shadow-[0_18px_50px_rgba(7,24,43,0.10)] overflow-hidden hover:shadow-[0_24px_60px_rgba(7,24,43,0.13)] transition-shadow duration-300"
          >
            <div class="grid md:grid-cols-2 gap-0">
              <div class="p-8 md:p-10 flex flex-col justify-between">
                <div>
                  <span class="text-xs uppercase tracking-[.3em] text-gold mb-3 block">Dubai Office</span>
                  <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-2">Dubai, United Arab Emirates</h3>
                  <p class="text-slate-500 text-sm sm:text-base">office location</p>
                </div>
                <div class="mt-8">
                  <span class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-navy text-white font-semibold text-sm hover:bg-navy/90 transition">
                    Get Directions
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15 3 21 3 21 9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </span>
                  <p class="text-slate-400 text-xs mt-3">View office location on Google Maps</p>
                </div>
              </div>
              <div class="relative bg-[#ecece6] min-h-[220px] md:min-h-full overflow-hidden">
                <div class="absolute inset-0 opacity-40" aria-hidden="true"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="relative">
                    <div class="absolute -inset-8 rounded-full border border-gold/20" aria-hidden="true"></div>
                    <div class="absolute -inset-16 rounded-full border border-gold/10" aria-hidden="true"></div>
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-navy relative z-10">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="currentColor"></path>
                      <circle cx="12" cy="9" r="2.5" fill="#f7f6f2"></circle>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </div>
      )}
      <div class="flex flex-col gap-5 reveal">
        <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 bg-white/10 hover:bg-white/15 transition rounded-2xl p-6 border border-white/10 hover:border-gold/40 lift-card group">
          <span class="w-12 h-12 rounded-full bg-[#25D366] flex items-center justify-center text-xl ring-2 ring-white/30">💬</span>
          <span class="flex-1">
            <span class="block font-semibold">{t.cards?.whatsapp?.title || 'WhatsApp'}</span>
            <span class="block text-white/60 text-sm">{t.cards?.whatsapp?.description || 'Instant response'}</span>
          </span>
          <span aria-hidden="true" class="cta-arrow text-white/60">{contactArrow}</span>
        </a>
        <a href={"mailto:" + siteConfig.contact.email} class="flex items-center gap-4 bg-white/10 hover:bg-white/15 transition rounded-2xl p-6 border border-white/10 hover:border-gold/40 lift-card group">
          <span class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-xl ring-2 ring-white/20">✉️</span>
          <span class="flex-1">
            <span class="block font-semibold">{t.cards?.email?.title || 'Email'}</span>
            <span class="block text-white/60 text-sm">{siteConfig.contact.email}</span>
          </span>
          <span aria-hidden="true" class="cta-arrow text-white/60">{contactArrow}</span>
        </a>
        <a href={"tel:" + siteConfig.contact.phone} class="flex items-center gap-4 bg-white/10 hover:bg-white/15 transition rounded-2xl p-6 border border-white/10 hover:border-gold/40 lift-card group">
          <span class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-xl ring-2 ring-white/20">📞</span>
          <span class="flex-1">
            <span class="block font-semibold">{t.cards?.phone?.title || 'Phone'}</span>
            <span class="block text-white/60 text-sm">{displayPhone}</span>
          </span>
          <span aria-hidden="true" class="cta-arrow text-white/60">→</span>
        </a>
        <a
          href="https://maps.app.goo.gl/gueak6ZVLNiN3eAF6"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open Dubai office location in Google Maps"
          class="flex items-center gap-4 bg-white/10 hover:bg-white/15 transition rounded-2xl p-6 border border-white/10 hover:border-gold/40 lift-card group"
        >
          <span class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-xl ring-2 ring-white/20">📍</span>
          <span class="flex-1">
            <span class="block font-semibold">{t.cards?.office?.title || 'Office'}</span>
            <span class="block text-white/60 text-sm">{t.cards?.office?.description || siteConfig.contact.address}</span>
          </span>
          <span aria-hidden="true" class="cta-arrow text-white/60">{contactArrow}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .dubai-office-card {
    text-decoration: none;
    color: inherit;
  }

  .dubai-office-card:focus-visible {
    outline: 3px solid rgba(197, 156, 7, 0.72);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dubai-office-card {
      transition: none;
    }
  }
</style>
