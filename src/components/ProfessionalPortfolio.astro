---
const executiveRoles = [
  {
    position: 'Chief Executive Officer',
    organization: 'Elite Maison Marketing Consultancies',
    description: 'I lead strategy and operations for the consultancy’s marketing and business growth engagements.'
  },
  {
    position: 'Founder',
    organization: 'AI Brains',
    description: 'I direct strategy and growth for the AI Brains venture ecosystem and its product portfolio.'
  }
];

const advisoryRoles = [
  {
    organization: 'ManageMARK- Dubai',
    position: 'Marketing Consultant and Management Trainer.'
  },
  {
    organization: 'One Place- Ajman/ Mood Group- Dubai',
    position: 'Marketing Consultant'
  },
  {
    organization: 'Enmacon- Damascus/ Wago Gold Trading',
    position: 'Business Development Consultant'
  },
  {
    organization: 'Bin Jassim Group for Business Solutions',
    position: 'General Manager'
  },
  {
    organization: 'Zen Diamond- Iraq',
    position: 'Recruitment and HR Consultant'
  },
  {
    organization: 'Pareto Academy- Iraq',
    position: 'Business Development and Marketing Consultant'
  }
];

const venturesItems = [
  'Kaveo',
  'AIRIS',
  'HOLORISER',
  'MotorK'
];

const books = [
  {
    title: 'The Customer Effect',
    idea: 'Behind every customer, 3600 potential customers.'
  },
  {
    title: 'The Business Developer’s Mindset',
    idea: 'A strategic guide to business development, growth, and market expansion.'
  },
  {
    title: 'Why People Buy',
    idea: 'The hidden psychology of buying decisions.'
  }
];
---

<section id="professional-portfolio" class="relative bg-white">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-24">
    <div class="text-center mb-16 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-gold mb-3 block">
        Professional Portfolio
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-navy title-underline inline-block">
        One source, My Complete Professional Background
      </h2>
      <span class="block mt-5 h-px w-16 bg-gold/70 mx-auto"></span>
      <p class="text-slate-500 max-w-2xl mx-auto mt-6 text-base sm:text-lg leading-relaxed">
        Everything I lead, advise, build, and publish in one place, for anyone who needs the full picture quickly.
      </p>
    </div>

    <div class="mb-20">
      <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-8 text-center reveal">
        1. Executive Leadership
      </h3>
      <div class="grid md:grid-cols-2 gap-6">
        {executiveRoles.map((role, i) => (
          <article class={`reveal delay-${i + 1} card-premium group relative bg-slate-50 ring-1 ring-slate-100 rounded-3xl p-8 sm:p-10`}>
            <span aria-hidden="true" class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold/70 via-gold/90 to-gold/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-t-3xl"></span>
            <div class="leading-relaxed text-slate-600">
              <p>
                <strong class="font-semibold text-navy">{role.position}</strong>
                <span aria-hidden="true"> | </span>
                <span>{role.organization}</span>
              </p>
              <p class="mt-1">{role.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mb-20">
      <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-8 text-center reveal">
        2. Advisory Roles
      </h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {advisoryRoles.map((role, i) => (
          <article class={`reveal delay-${i + 1} card-premium group relative bg-slate-50 ring-1 ring-slate-100 rounded-3xl p-6 sm:p-8`}>
            <span aria-hidden="true" class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold/70 via-gold/90 to-gold/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-t-3xl"></span>
            <div class="leading-relaxed text-slate-600">
              <p>
                <strong class="font-semibold text-navy block text-base sm:text-lg mb-1">{role.organization}</strong>
                <span class="text-slate-500 text-sm sm:text-base">{role.position}</span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mb-20">
      <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-8 text-center reveal">
        3. Ventures and Products
      </h3>
      <div class="reveal card-premium relative overflow-hidden rounded-3xl bg-slate-50 ring-1 ring-slate-100 p-8 sm:p-12">
        <div aria-hidden="true" class="pointer-events-none absolute -right-10 -top-10 h-64 w-64 rounded-full border border-gold/20"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -left-16 -bottom-16 h-72 w-72 rounded-full border border-gold/10"></div>
        <div class="relative">
          <p class="text-slate-600 leading-relaxed text-base sm:text-lg max-w-4xl">
            I lead the AI Brains ecosystem- a connected portfolio of products and ventures built and advised under a single innovation umbrella: Kaveo, AIRIS, HOLORISER, and MotorK, each applying the same strategic and business development thinking to a different part of the market.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            {venturesItems.map((item) => (
              <span class="rounded-full border border-navy/10 bg-white px-4 py-1.5 text-sm font-medium text-navy">{item}</span>
            ))}
          </div>
          <div class="mt-10">
            <a
              href="#ventures"
              class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy/90"
            >
              See the full ecosystem
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-20">
      <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-8 text-center reveal">
        4. Training Profile
      </h3>
      <div class="reveal card-premium relative rounded-3xl bg-slate-50 ring-1 ring-slate-100 p-8 sm:p-12">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="text-slate-600 leading-relaxed text-base sm:text-lg max-w-3xl">
            I’ve delivered executive programs, corporate training, and workshops on strategy, business development, and growth across the UAE for over 18 years, training +6250 professionals.
          </div>
          <div class="shrink-0 text-center md:text-right">
            <span class="block text-4xl font-bold text-navy">+6250</span>
            <span class="block text-sm text-slate-500">Professionals trained</span>
          </div>
        </div>
        <div class="mt-8">
          <a
            href="#training"
            class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy/90"
          >
            View the Training page
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mb-20">
      <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-8 text-center reveal">
        5. Business Development Portfolio
      </h3>
      <div class="reveal card-premium relative rounded-3xl bg-slate-50 ring-1 ring-slate-100 p-8 sm:p-12">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <p class="text-slate-600 leading-relaxed text-base sm:text-lg">
              Real business development and marketing results, from a single-chair dental clinic that grew into a 15 doctor medical center, to a cafe that became a 9 branch franchise across the UAE.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-100">
              <span class="block text-3xl font-bold text-navy">15</span>
              <span class="block text-sm text-slate-500">doctor medical center</span>
            </div>
            <div class="rounded-2xl bg-white p-5 ring-1 ring-slate-100">
              <span class="block text-3xl font-bold text-navy">9</span>
              <span class="block text-sm text-slate-500">branch franchise across the UAE</span>
            </div>
          </div>
        </div>
        <div class="mt-8">
          <a
            href="#success"
            class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy/90"
          >
              See All Success Stories

            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div>
      <h3 class="text-2xl sm:text-3xl font-bold text-navy mb-8 text-center reveal">
        6. Books & Publications
      </h3>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {books.map((book, i) => (
          <article class={`reveal delay-${i + 1} card-premium group relative flex h-full flex-col rounded-3xl bg-slate-50 ring-1 ring-slate-100 p-6 sm:p-8 transition hover:shadow-lg`}>
            <span aria-hidden="true" class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-gold/70 via-gold/90 to-gold/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-t-3xl"></span>
            <div class="flex-1">
              <p class="text-base font-semibold text-navy sm:text-lg">{book.title}</p>
              <p class="mt-2 text-sm text-slate-500 sm:text-base">{book.idea}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a
          href="#books"
          class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 text-sm font-semibold text-white transition hover:bg-navy/90"
        >
          Explore the books
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
