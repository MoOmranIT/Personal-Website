    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <div
        class="flip-card reveal delay-1 cursor-pointer"
        data-flipped="false"
        role="button"
        tabindex="0"
        aria-label={stories[0].title + ' — ' + stories[0].headline}
      >
        <div class="flip-inner shadow-xl h-full">
          <div class="flip-front relative h-full">
            <img
              src={stories[0].image}
              alt={stories[0].alt}
              width="700"
              height="700"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent flex items-end p-6">
