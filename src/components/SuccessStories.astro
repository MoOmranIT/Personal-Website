<section id="success" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-slate-400 mb-3 block">
        Real Results
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-navy title-underline inline-block">
        Success Stories
      </h2>
      <p class="text-slate-500 max-w-2xl mx-auto mt-6">
        Hover over each card to reveal the story behind the results. Real partnerships, real transformation.
