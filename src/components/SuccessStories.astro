              <p class="text-white/80 text-sm leading-relaxed">{stories[0].description}</p>
            </div>
            <a href="#contact" class="inline-flex items-center gap-2 text-gold font-semibold text-sm mt-6 group">
              Read More <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
