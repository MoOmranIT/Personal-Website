---
interface Props {
  translations?: {
    success?: {
      badge?: string;
      heading?: string;
      description?: string;
      cta?: string;
      ctaFull?: string;
      items?: { id?: string; title?: string; headline?: string; excerpt?: string; description?: string; image?: string; alt?: string }[];
    };
  };
  lang?: string;
}

const { translations = {}, lang = 'en' } = Astro.props;
const t = translations.success || {};
const arrow = lang === 'ar' ? '←' : '→';

const stories = (t.items || []).map((item) => ({
  ...item,
  image: item.image || '/images/story.jpg',
  alt: item.alt || item.title || 'Success story'
}));
---

<style>
  .story-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .story-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }
  .story-modal {
    background: #fff;
    color: #1b2130;
    border-radius: 1.5rem;
    max-width: 720px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    transition: transform 0.3s var(--ease-out-expo), opacity 0.3s var(--ease-out-expo);
    box-shadow: 0 30px 55px -15px #0b1c398c;
    will-change: transform, opacity;
  }
  .story-modal-backdrop.open .story-modal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .story-modal p,
  .story-modal li {
    line-height: 1.7;
  }
  .story-modal .story-hero {
    border-radius: 1.2rem;
    height: 12rem;
    object-fit: cover;
    width: 100%;
  }
  .story-modal .story-body {
    padding: 1.5rem 1.75rem 1rem;
  }
</style>

<section id="success" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-16 reveal">
      <span class="text-xs uppercase tracking-[.3em] text-slate-400 mb-3 block">
        {t.badge || 'Real Results'}
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-navy title-underline inline-block">
        {t.heading || 'Success Stories'}
      </h2>
      <p class="text-slate-500 max-w-2xl mx-auto mt-6">
        {t.description || 'Hover over each card to reveal the story behind the results. Real partnerships, real transformation.'}
      </p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {stories.map((story, i) => (
        <div
          class="flip-card reveal cursor-pointer"
          data-flipped="false"
          role="button"
          tabindex="0"
          aria-label={story.title + ' — ' + story.headline}
        >
          <div class="flip-inner shadow-xl h-full">
            <div class="flip-front relative h-full">
              <img
                src={story.image}
                alt={story.alt}
                width="700"
                height="700"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent flex items-end p-6">
                <h3 class="text-white text-xl font-bold">
                  {story.title}
                </h3>
              </div>
            </div>
            <div class="flip-back p-8 flex flex-col justify-between h-full">
              <div>
                <span class="gold text-xs uppercase tracking-widest">{story.id}</span>
                <h3 class="text-xl font-bold mt-2 mb-4">{story.headline}</h3>
                <p class="text-white/80 text-sm leading-relaxed">{story.excerpt || story.description}</p>
              </div>
              <button
                type="button"
                class="story-open-btn inline-flex items-center gap-2 text-gold font-semibold text-sm mt-6 group"
                data-index={i}
              >
                {t.ctaFull || t.cta || (lang === 'ar' ? 'اقرأ القصة كاملة' : 'Read the Full Story')}
                <span class="cta-arrow" aria-hidden="true">{arrow}</span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="story-modal-backdrop" id="story-modal" aria-hidden="true">
    <div class="story-modal" role="dialog" aria-modal="true" aria-label={t.heading || 'Success Stories'}>
      <div class="px-5 sm:px-8">
        <div class="flex items-start justify-between gap-4 pt-5 sm:pt-8">
          <div class="flex-1">
            <span class="gold text-xs uppercase tracking-widest" id="story-modal-id"></span>
            <h3 class="text-2xl sm:text-3xl font-bold text-navy mt-2" id="story-modal-title"></h3>
            <span aria-hidden="true" class="mt-5 block h-0.5 w-12 bg-gold/70"></span>
          </div>
          <button
            type="button"
            id="story-modal-close"
            class="mt-1 w-11 h-11 rounded-full border border-navy/15 bg-white/90 text-navy hover:bg-navy hover:text-white hover:border-gold/60 transition-all duration-300 flex items-center justify-center"
            aria-label={lang === 'ar' ? 'إغلاق' : 'Close'}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="mt-5">
          <img class="story-hero" id="story-modal-image" width="720" height="300" alt="" />
        </div>
      </div>
      <div class="story-body text-slate-600 text-lg leading-relaxed space-y-4" id="story-modal-body"></div>
      <div class="px-5 sm:px-8 py-6 text-center">
        <a href={lang === 'ar' ? '/ar/#contact' : '#contact'} class="btn-navy btn-sheen px-8 py-3.5 rounded-full font-semibold">
          {t.cta || 'Book a Session'}
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline set:html={`
  window.__SUCCESS_STORIES__ = ${JSON.stringify(stories).replace(/</g, '\\u003c')};
`}></script>

<script>
  (function () {
    const storyData = window.__SUCCESS_STORIES__ || [];
    const modal = document.getElementById('story-modal');
    const modalTitle = document.getElementById('story-modal-title');
    const modalId = document.getElementById('story-modal-id');
    const modalBody = document.getElementById('story-modal-body');
    const closeBtn = document.getElementById('story-modal-close');
    const openButtons = document.querySelectorAll('.story-open-btn');

    function formatStory(text) {
      if (!text) return '';
      const lines = text.split('\n').filter((line) => line.trim() !== '');
      if (lines.length <= 1) {
        return '<p>' + escapeHtml(text) + '</p>';
      }
      const html = lines.map((line) => {
        const trimmed = line.trim();
        if (trimmed.startsWith('- ')) {
          return '<li>' + escapeHtml(trimmed.slice(2)) + '</li>';
        }
        if (/^##\s/.test(trimmed)) {
          return '<h4 class="text-navy font-bold text-xl mt-6 mb-2">' + escapeHtml(trimmed.replace(/^##\s*/, '')) + '</h4>';
        }
        return '<p>' + escapeHtml(trimmed) + '</p>';
      });
      if (html.some((item) => item.startsWith('<li>'))) {
        return '<ul class="list-disc pl-6 space-y-2">' + html.map((item) => item.startsWith('<li>') ? item : '<p>' + item.replace(/^<p>|<\/p>$/g, '') + '</p>').join('') + '</ul>';
      }
      return html.join('');
    }

    function escapeHtml(text) {
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function openModal(index) {
      const story = storyData[index];
      if (!story || !modal) return;
      modalId.textContent = story.id || '';
      modalTitle.textContent = story.title || '';
      const hero = document.getElementById('story-modal-image') as HTMLImageElement | null;
      if (hero) {
        hero.src = story.image || '';
        hero.dataset.hero = story.alt || story.title || '';
      }
      modalBody.innerHTML = formatStory(story.description || story.excerpt || '');
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeModal() {
      modal?.classList.remove('open');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const index = parseInt(btn.getAttribute('data-index') || '0', 10);
        openModal(index);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>
