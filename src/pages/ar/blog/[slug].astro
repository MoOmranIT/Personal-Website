---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogArticle from '../../../components/blog/BlogArticle.astro';
import { siteConfig } from '../../../scripts/siteConfig';
import { ar } from '../../../i18n/ar';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'ar' && !data.draft);
  const all = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((article) => ({ params: { slug: article.data.slug }, props: { article, counterpart: all.find((item) => item.data.translationKey === article.data.translationKey && item.data.lang === 'en') } }));
}

const { article, counterpart } = Astro.props;
const { Content } = await render(article);
const canonical = `${siteConfig.url}ar/blog/${article.data.slug}/`;
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.excerpt,
  image: `${siteConfig.url}${article.data.image.replace(/^\//, '')}`,
  datePublished: article.data.publishedAt.toISOString().slice(0, 10),
  author: {
    '@type': 'Person',
    name: 'Dr. Khaled Al Mohammad',
    url: `${siteConfig.url}`
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical
  },
  url: canonical,
  inLanguage: 'ar'
};
---

<BaseLayout
  title={`${article.data.title} | د. خالد المحمد`}
  description={article.data.excerpt}
  ogDescription={article.data.excerpt}
  twitterDescription={article.data.excerpt}
  image={article.data.image}
  lang="ar"
  dir="rtl"
  robots={article.data.indexable ? 'index, follow' : 'noindex, follow'}
  canonical={canonical}
  translations={counterpart ? { en: { href: `${siteConfig.url}blog/${counterpart.data.slug}/` }, ar: { href: canonical } } : { ar: { href: canonical } }}
>
  {article.data.indexable && <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogPosting)} />}
  <Header translations={ar.nav} currentLang="ar" languageSwitcherHref={counterpart ? `/blog/${counterpart.data.slug}/` : '/blog/'} isBlog />
  <BlogArticle article={article} body={Content} counterpart={counterpart} lang="ar" />
  <Footer translations={ar} lang="ar" isBlog />
</BaseLayout>
