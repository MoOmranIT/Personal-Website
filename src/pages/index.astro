---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Audience from '../components/Audience.astro';
import About from '../components/About.astro';
import Books from '../components/Books.astro';
import SuccessStories from '../components/SuccessStories.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { siteConfig } from '../scripts/siteConfig';
import { en } from '../i18n/en';
---

<BaseLayout
  title={siteConfig.seo.en.title}
  description={siteConfig.seo.en.description}
  ogDescription={siteConfig.seo.en.ogDescription}
  twitterDescription={siteConfig.seo.en.twitterDescription}
  lang="en"
  dir="ltr"
  canonical={siteConfig.url}
  translations={{
    en: { href: siteConfig.url },
    ar: { href: siteConfig.url + 'ar/' }
  }}
>
  <ScrollProgress />
  <Header translations={en.nav} currentLang="en" />
  <main>
    <Hero translations={en} lang="en" />
    <Services translations={en} lang="en" />
    <Audience translations={en} lang="en" />
    <About translations={en} lang="en" />
    <Books translations={en} lang="en" />
    <SuccessStories translations={en} lang="en" />
    <Contact translations={en} lang="en" />
  </main>
  <Footer translations={en} lang="en" />
  <a
    href={siteConfig.contact.whatsapp}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
    class="float-wa fixed bottom-6 right-6 z-50 w-16 h-16 rounded-full bg-[#25D366] flex items-center justify-center text-3xl shadow-2xl hover:scale-110 transition-transform"
  >
    💬
  </a>
  <BackToTop lang="en" />
</BaseLayout>
